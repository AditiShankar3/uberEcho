# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and insert your real OpenAI API key:
#   cp .env.example .env
# ==============================================================================

# OpenAI API Key for Grounded Response Drafting and LLM-as-a-Judge
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Configuration
LLM_MODEL=gpt-4o-mini

# Semantic Confidence & Gating Thresholds
CONFIDENCE_THRESHOLD=0.45
INTENT_CONF_THRESHOLD=0.60